# $(x) = 0
# .() = 1
# ; tells the compiler to merge two lines
$(;
    .(a1 = 1);
    .(a2 = 0);
    .(a3 = 0);
    .(;
        .(loop(i, n) = $(;
            .(if(i - n)());
            .(else(i - n) $(;
                .(a1 = a2);
                .(a2 = a3);
                .(a3 = a1 + a2);
                .(loop(i + 1, n));
            ));
        ));
        .(loop(0, 10));
    );
    .(print(a1));
)