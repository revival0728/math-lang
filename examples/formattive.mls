# $(x) = None
# .() = 1

$(
    .(M = 1000000007)
    .(a1 = 1)
    .(a2 = 1)
    .(a3 = 0)
    .(
        .(loop(i, n) = (
            .(if(i - n)())
            .(else(i - n)(
                .(a3 = a1 + a2 mod M)
                .(a1 = a2)
                .(a2 = a3)
                .(loop(i + 1, n))
            ))
        ))
        .(loop(0, 500))
    )
    .(print(a1))
)