# init array with length of 5
seq = Sequence(3)

# init array values
seq:0 = 0
seq:-2 = 1   # same as "seq:1 = 1"
seq:-1 = 1   # same as "seq:2 = 1"

# do algorithm
$(
    .(loop(i, n) = (
        .(if(i - n)())
        .(else(i - n)(
            .(seq:2 = seq:0 + seq:1)
            .(seq:0 = seq:1)
            .(seq:1 = seq:2)
            .(loop(i + 1, n))
        ))
    ))
    .(loop(0, 10))
)

# print answer
print("fib(10) = ")
println(seq:0)